From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] (Fix) Use MSYS diffutils for Windows preparation

The MINGW64 repository no longer provides its diffutils package.
Use the MSYS package from usr/bin, which is already on the preparation
PATH, while keeping the remaining native build tools unchanged.

diff --git a/Telegram/build/prepare/prepare.py b/Telegram/build/prepare/prepare.py
--- a/Telegram/build/prepare/prepare.py
+++ b/Telegram/build/prepare/prepare.py
@@ -478,7 +478,7 @@ win:
     bash -c "pacman-key --init; pacman-key --populate; pacman -Syu --noconfirm"
     pacman -Syu --noconfirm ^
         make ^
-        mingw-w64-x86_64-diffutils ^
+        diffutils ^
         mingw-w64-x86_64-gperf ^
         mingw-w64-x86_64-nasm ^
         mingw-w64-x86_64-perl ^
